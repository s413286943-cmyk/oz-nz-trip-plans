[project]
sub_id = "64d927e1"
name = "oz-nz-trip-plans"
requires = ["nodejs-24"]
project_type = "web"
version = "0.1.9"

[preview]
preview_enable = "enabled"

[dev]
build = ["bash", ".cozeproj/scripts/dev_build.sh"]
run = ["bash", ".cozeproj/scripts/dev_run.sh"]

[deploy]
build = ["bash", ".cozeproj/scripts/deploy_build.sh"]
run = ["bash", ".cozeproj/scripts/deploy_run.sh"]

[deploy.profile]
kind = "service"
flavor = "web"

[subprojects]
path = ["."]